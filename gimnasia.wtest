	import personas.*
	import gimnasia.*
	import clubes.*

	describe "rutinas" {
		//RUTINAS
		const correrEnLaPlaya = new Running(intensidad = 1.2)
		const correrMaraton = new Maraton(intensidad=1.2)
		const remarEnElDelta = new Remo()
		const remoDeCompeticion = new RemoCompeticion()

		//PERSONAS
		const calamardo= new PersonaSedentaria(tiempo = 5, peso = 60)
		const bob = new PersonaAtleta(peso = 40)

		//CLUBES
		const recreo = new Predio (rutinas = [correrEnLaPlaya,correrMaraton])
		const nautico = new Predio (rutinas = [remarEnElDelta,remoDeCompeticion])
		const clubBarrial = new Club(predios = [recreo,nautico])
		



		test "corriendo en la playa"{
			assert.equals(1.2, correrEnLaPlaya.intensidad())
			correrEnLaPlaya.caloriasQuemadas(12)
			assert.equals(1200,correrEnLaPlaya.caloriasQuemadas(12))
		}
		test "corriendo maraton"{
			assert.equals(1.2, correrMaraton.intensidad())
			assert.equals(2400,correrMaraton.caloriasQuemadas(12))
		}
		test "Remo en delta"{
			assert.equals(520, remarEnElDelta.caloriasQuemadas(5))
			assert.equals(9360, remarEnElDelta.caloriasQuemadas(90))
		}
		test "Remo Competicion"{
			assert.equals(510, remoDeCompeticion.caloriasQuemadas(5))
			assert.equals(12750, remoDeCompeticion.caloriasQuemadas(90))
		}
		//PERSONAS//////////////////////////////////




		test "Calamardo ejercitando"{
			
			assert.equals(60, calamardo.peso())
			calamardo.realizarRutina(correrEnLaPlaya)
			assert.equals(59.948, calamardo.peso().truncate(3))
		}
		test "Calamardo maraton"{
			calamardo.realizarRutina(correrMaraton)
			assert.equals(59.871, calamardo.peso().truncate(3))
		}
		test"Calamardo delta"{
			calamardo.realizarRutina(remarEnElDelta)
			assert.equals(59.925, calamardo.peso().truncate(3))
		}
		test "calamardo camino remeros"{
			calamardo.realizarRutina(remoDeCompeticion)
			assert.equals(59.927, calamardo.peso().truncate(3))
		}




		test "bob corre"{
			bob.realizarRutina(correrEnLaPlaya)
			assert.equals(39.725, bob.peso().truncate(3))
		}
		test "bob maraton"{
			bob.realizarRutina(correrMaraton)
			assert.equals(37.812, bob.peso().truncate(3))
		}
		test "bob delta"{
			assert.throwsException({ bob.realizarRutina(remarEnElDelta) })
		}
		test "bob camino de los remeros"{
			bob.realizarRutina(remoDeCompeticion)
			assert.equals(39.406, bob.peso().truncate(3))
		}
		

		//CLUBES
		test "El mejor predio"{
			assert.equals(recreo, clubBarrial.mejorPredio(bob))
			assert.equals(recreo, clubBarrial.mejorPredio(calamardo))
		}
		
		test "predios tranquis"{
			assert.equals([], clubBarrial.prediosTranquis(bob))
			assert.equals([recreo], clubBarrial.prediosTranquis(calamardo))
		}
		test "rutinas mas exigentes"{
			assert.equals([correrMaraton, remoDeCompeticion], clubBarrial.rutinasMasExigentes(bob))
			assert.equals([correrMaraton, remarEnElDelta], clubBarrial.rutinasMasExigentes(calamardo))
		}
	}


//	test "3.3 rutinas más exigentes" {
//		//Las rutinas más exigentes del clubBarrial para bob son maratonBA y remarEnCaminoRemeros
//		//Las rutinas más exigentes del clubBarrial para calamardo son maratonBA y remarEnElDelta
//	}
	